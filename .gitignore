.DS_Store

# Godot's import/type cache. Regenerated by `godot --import`.
game/.godot/

# GDExtension build output, copied in from the engine fork by the build step
# (or by CI for the web). The engine is a submodule built from source.
game/bin/*.framework/
game/bin/*.dll
game/bin/*.so
game/bin/*.wasm

# Web export output; CI publishes it, nobody commits it.
web/
shots/
